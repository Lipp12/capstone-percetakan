# Base URL API milik Alif, tanpa trailing slash.
# Contoh: VITE_API_BASE_URL=https://api.alif.dev/v1
# Kosongkan untuk memakai mode demo lokal (localStorage, tanpa backend).
VITE_API_BASE_URL=

# Token Bearer opsional. Jika diisi, dikirim sebagai Authorization: Bearer <token>.
VITE_API_TOKEN=

# Endpoint dapat disesuaikan tanpa mengubah kode.
VITE_PRODUCTS_ENDPOINT=/products
VITE_ORDERS_ENDPOINT=/orders
