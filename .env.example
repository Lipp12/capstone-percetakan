# OpenRouter API Configuration
AI_BASE_URL="https://openrouter.ai/api/v1"

AI_MODEL="openrouter/free"

# Database (PostgreSQL)
# L locally: pakai file db (lihat prisma/schema.prisma datasource)
# Production (Railway/Neon): pakai connection string PostgreSQL
# DATABASE_URL="postgresql://..."

# Auth
# Generate dengan: openssl rand -base64 32
# NEXTAUTH_SECRET="..."
# NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Cloudinary (WAJIB di-set untuk production)
# ----------------------------------------------------------------------------
# Tanpa ketiga variable di bawah, lib/upload.ts akan jatuh ke fallback lokal
# yang menulis ke public/uploads/. Di Railway filesystem bersifat ephemeral:
# file yang diupload pengguna HILANG setiap kali app di-restart/deploy.
# File hasil seed (public/uploads/designs/*.pdf) tetap aman karena ikut ter-build.
#
# Ambil kredensial gratis di https://cloudinary.com (plan Free cukup untuk demo)
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# Catalogue: semua environment variable yang dipakai app ini
# AI_BASE_URL, AI_MODEL, DATABASE_URL, NEXTAUTH_SECRET, NEXTAUTH_URL,
# CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET,
# ALIF_API_BASE_URL, ALIF_API_TOKEN, ALIF_ORDERS_ENDPOINT, ALIF_PRODUCTS_ENDPOINT

# ----------------------------------------------------------------------------
# API Alif (opsional). Jika ALIF_API_BASE_URL kosong, app berjalan dalam mode
# mock (pesanan tetap disimpan ke DB lokal).
# Token bersifat rahasia: hanya dipakai di server (route handler), jangan
# pernah diberi awalan NEXT_PUBLIC_.
# ----------------------------------------------------------------------------
# ALIF_API_BASE_URL="https://api-alif.example.com"
# ALIF_API_TOKEN="..."
# ALIF_ORDERS_ENDPOINT="/orders"
# ALIF_PRODUCTS_ENDPOINT="/products"

# ----------------------------------------------------------------------------
# WhatsApp (opsional, untuk tombol kalkulator di landing page)
# ----------------------------------------------------------------------------
# Format internasional tanpa "+" dan tanpa spasi, contoh: 628211901042
# Boleh juga ditulis 0821-1901-042, dinormalisasi otomatis.
# NEXT_PUBLIC_WHATSAPP_NUMBER="628211901042"