# OpenRouter API Configuration
AI_BASE_URL="https://openrouter.ai/api/v1"

AI_MODEL="openrouter/free"

# Database (PostgreSQL)
# L locally: pakai file db (lihat prisma/schema.prisma datasource)
# Production (Railway/Neon): pakai connection string PostgreSQL
# DATABASE_URL="postgresql://..."

# Auth
# Generate dengan: openssl rand -base64 32
# NEXTAUTH_SECRET="..."
# NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Cloudinary (WAJIB di-set untuk production)
# ----------------------------------------------------------------------------
# Tanpa ketiga variable di bawah, lib/upload.ts akan jatuh ke fallback lokal
# yang menulis ke public/uploads/. Di Railway filesystem bersifat ephemeral:
# file yang diupload pengguna HILANG setiap kali app di-restart/deploy.
# File hasil seed (public/uploads/designs/*.pdf) tetap aman karena ikut ter-build.
#
# Ambil kredensial gratis di https://cloudinary.com (plan Free cukup untuk demo)
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# ----------------------------------------------------------------------------
# Midtrans Snap (pembayaran otomatis)
# ----------------------------------------------------------------------------
# Ambil di Midtrans MAP > Settings > Access Keys (pakai Sandbox dulu saat dev).
# SERVER KEY dan SIGNATURE SECRET KEY: RAHASIA, jangan pernah pakai prefix NEXT_PUBLIC_.
# CLIENT KEY: publik, dipakai Snap.js untuk popup. Boleh dikosongkan —
# aplikasi otomatis memakai halaman pembayaran Midtrans (redirect).
MIDTRANS_SERVER_KEY="SB-Mid-server-REPLACE_WITH_SANDBOX_SERVER_KEY"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-REPLACE_WITH_SANDBOX_CLIENT_KEY"
# Opsional. Sejak 28 Okt 2026 notifikasi ditandatangani dengan Signature Secret Key.
# Kalau kosong, Server Key dipakai sebagai fallback (akun Midtrans lama).
MIDTRANS_SIGNATURE_SECRET_KEY="..."
# true hanya untuk akun Production. Sandbox = false (default).
MIDTRANS_IS_PRODUCTION="false"
# Dipakai untuk callback finish/pending/error Snap. Tanpa ini, callback diatur dari dashboard.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Catalogue: semua environment variable yang dipakai app ini
# AI_BASE_URL, AI_MODEL, DATABASE_URL, NEXTAUTH_SECRET, NEXTAUTH_URL,
# CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET,
# MIDTRANS_SERVER_KEY, NEXT_PUBLIC_MIDTRANS_CLIENT_KEY,
# MIDTRANS_SIGNATURE_SECRET_KEY, MIDTRANS_IS_PRODUCTION, NEXT_PUBLIC_SITE_URL

# ----------------------------------------------------------------------------
# WhatsApp (opsional, untuk tombol kalkulator di landing page)
# ----------------------------------------------------------------------------
# Format internasional tanpa "+" dan tanpa spasi, contoh: 628211901042
# Boleh juga ditulis 0821-1901-042, dinormalisasi otomatis.
# NEXT_PUBLIC_WHATSAPP_NUMBER="628211901042"